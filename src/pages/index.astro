---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import erinImage from '~/assets/images/erin_rodendan.jpeg';

const metadata = {
  title: 'Erin 1. rođendan',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero2
    title="Erin nam slavi 1. rodendan!"
    actions={[
      { variant: 'primary', text: 'Potvrdite svoj dolazak', href: 'javascript:openModal()', icon: 'tabler:square-rounded-arrow-right' },
    ]}
    image={{
      src: erinImage,
      alt: 'Erin slavi rođendan',
      class: 'object-contain max-h-96 md:max-h-screen w-full',
    }}
  />

  <!-- Google Maps sekcija -->
  <section class="py-4 md:py-20 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      
      <!-- Dugme za navigaciju -->
      <div class="text-center mb-6">
        <a
          href="https://maps.app.goo.gl/dFdSenS7happZUoj9"
          target="_blank"
          class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-primary rounded-lg hover:bg-primary-600 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
          </svg>
          ODVEDI ME DO MJESTA SLAVLJA
        </a>
      </div>
      
      <!-- Google Maps iframe -->
      <div class="mb-8">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1903.978413826508!2d17.12244860140543!3d45.70388850824934!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4767bb1849a43a27%3A0xba4623ad6a5f0ba2!2sGrbavac%2041%2C%2043290%2C%20Grbavac!5e0!3m2!1shr!2shr!4v1755384555563!5m2!1shr!2shr"
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="rounded-lg">
        </iframe>
      </div>
      
      
    </div>
  </section>

  <!-- Modal za Google Form -->
  <div id="rsvpModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-hidden relative">
      <button onclick="window.closeModal()" class="absolute top-4 right-4 text-gray-500 hover:text-gray-700 z-10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <iframe 
        src="https://docs.google.com/forms/d/e/1FAIpQLSchWKPnVGe3XOQTuoYGyKvKOmZ0n3assBzqeT75p4kVbAWu6g/viewform?embedded=true"
        width="100%" 
        height="617" 
        style="border:0;"
        marginheight="0" 
        marginwidth="0">
        Učitavanje…
      </iframe>
    </div>
  </div>

</Layout>

<script is:inline>
  window.openModal = function() {
    document.getElementById('rsvpModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  window.closeModal = function() {
    document.getElementById('rsvpModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Čekaj da se DOM učita
  document.addEventListener('DOMContentLoaded', function() {
    // Zatvori modal kad se klikne van njega
    const modal = document.getElementById('rsvpModal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) {
          window.closeModal();
        }
      });
    }
  });
</script>